# Neon pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/db?sslmode=require"
# Neon direct connection string (used by prisma migrate)
DIRECT_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

# Random 32+ char string used to sign session cookies
AUTH_SECRET="change-me-to-a-long-random-string"
# Needed only until the first account exists; registration closes afterwards
SETUP_CODE="choose-a-private-code"
# Bearer secret Vercel Cron sends to /api/cron/recurring
CRON_SECRET="another-long-random-string"

# Passkeys: hostname the site is served from (no protocol) and its full origin
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# AI Receipt Scanning (Groq or Google Gemini API key)
GROQ_API_KEY="gsk_your-groq-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

